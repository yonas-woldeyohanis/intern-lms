# ============================================================
# BMVEI Library Management System - Docker Environment Config
# Copy this file to .env and fill in real values before deploying.
# ============================================================

# MySQL Database
DB_ROOT_PASSWORD=root_secure_password
DB_NAME=bmvei_lms
DB_USER=bmvei_app
DB_PASSWORD=secure_database_password

# JWT Secrets (MUST BE CHANGED TO LONG RANDOM STRINGS in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key

# Default Admin Credentials (Used by seed script on first startup)
ADMIN_DEFAULT_EMAIL=admin@bmvei.local
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe@12345
